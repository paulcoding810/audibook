<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup rules. Cloud backup is capped at 25 MB per app (above that nothing is backed up),
    so it only carries reading progress and settings; books are matched by fingerprint when re-added.
    Phone-to-phone transfer has no such cap, so it also moves the EPUBs and covers.
    Voice models are never included: they're large and can be downloaded again.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="audibook.db" />
        <include domain="database" path="audibook.db-wal" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="audibook.db" />
        <include domain="database" path="audibook.db-wal" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="books/" />
        <include domain="file" path="covers/" />
    </device-transfer>
</data-extraction-rules>
